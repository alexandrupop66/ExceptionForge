# Create an inference API key in your OWN Vultr account. Never commit it.
VULTR_INFERENCE_API_KEY=
VULTR_MODEL=deepseek-v4.1-flash-1017
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Only bind to localhost during local validation. Use a proper TLS reverse proxy on Vultr.

# Security gate: OFF until the operator explicitly approves real inference costs.
EXCEPTIONFORGE_ENABLE_LIVE=false
# Generate a unique unpredictable token (>=32 ASCII characters) locally.
# NEVER commit it or paste it in a public chat.
EXCEPTIONFORGE_ACCESS_TOKEN=
